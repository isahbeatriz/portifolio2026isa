const game = document.getElementById("game");
const scoreDisplay = document.getElementById("score");

const width = 20;
let cells = [];
let score = 0;
let gameRunning = true;

// 0 = banana | 1 = parede
const layout = new Array(400).fill(0);

// Criar paredes externas
for (let i = 0; i < 400; i++) {
  if (
    i < 20 ||
    i >= 380 ||
    i % 20 === 0 ||
    i % 20 === 19
  ) {
    layout[i] = 1;
  }
}

// Paredes internas simples
[42,43,44,62,82,102,122,142,162].forEach(i => layout[i] = 1);

// Criar grid
function createBoard() {
  game.innerHTML = "";
  cells = [];

  for (let i = 0; i < 400; i++) {
    const cell = document.createElement("div");
    cell.classList.add("cell");

    if (layout[i] === 1) {
      cell.classList.add("wall");
    } else {
      cell.classList.add("banana");
    }

    game.appendChild(cell);
    cells.push(cell);
  }
}

let monkey = 210;
let gorillas = [50, 70, 330];

// Render inicial
function render() {
  cells.forEach(cell => {
    cell.classList.remove("monkey", "gorilla");
  });

  cells[monkey].classList.add("monkey");
  gorillas.forEach(g => cells[g].classList.add("gorilla"));
}

// Movimento do macaco
function moveMonkey(e) {
  if (!gameRunning) return;

  let next = monkey;

  if (e.key === "ArrowUp") next -= width;
  if (e.key === "ArrowDown") next += width;
  if (e.key === "ArrowLeft") next -= 1;
  if (e.key === "ArrowRight") next += 1;

  if (!cells[next].classList.contains("wall")) {
    monkey = next;
  }

  eatBanana();
  checkCollision();
  render();
}

document.addEventListener("keydown", moveMonkey);

// Comer banana
function eatBanana() {
  if (cells[monkey].classList.contains("banana")) {
    cells[monkey].classList.remove("banana");
    score++;
    scoreDisplay.textContent = score;
  }
}

// IA dos gorilas (semi inteligente)
function moveGorillas() {
  if (!gameRunning) return;

  gorillas = gorillas.map(g => {
    const directions = [-1, 1, width, -width];

    // tenta ir na direção do macaco (simples)
    let bestMove = directions.sort(() => Math.random() - 0.5);

    for (let move of bestMove) {
      let next = g + move;

      if (!cells[next].classList.contains("wall")) {
        return next;
      }
    }

    return g;
  });

  checkCollision();
  render();
}

setInterval(moveGorillas, 400);

// Colisão
function checkCollision() {
  if (gorillas.includes(monkey)) {
    gameOver();
  }
}

// Game Over
function gameOver() {
  gameRunning = false;
  setTimeout(() => {
    alert("💀 Game Over! Pontuação: " + score);
  }, 100);
}

// Reiniciar
function restartGame() {
  score = 0;
  monkey = 210;
  gorillas = [50, 70, 330];
  gameRunning = true;
  scoreDisplay.textContent = 0;

  createBoard();
  render();
}

// Inicializar
createBoard();
render();